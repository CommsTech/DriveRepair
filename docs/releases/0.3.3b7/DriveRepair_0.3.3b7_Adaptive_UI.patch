+        self.assertIn('smartmontools.smartmontools', called[0][0])
+        self.assertNotIn('shell', called[0][1])
+        self.assertGreater(called[0][1]['timeout'], 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
