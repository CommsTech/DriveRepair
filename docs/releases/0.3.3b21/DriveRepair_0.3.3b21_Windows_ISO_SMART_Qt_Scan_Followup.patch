diff --git a/desktop/driverepair_desktop/scan_followup.py b/desktop/driverepair_desktop/scan_followup.py
new file mode 100644
--- /dev/null
+++ b/desktop/driverepair_desktop/scan_followup.py
@@ -0,0 +1,59 @@
+"""Read-only follow-up from a completed scan; no repeat full-surface sweep.
+
+Scan findings are hints, never write authority and never original data. A
+repeatable read is not a checksum-verified recovered file or repaired medium.
+"""
+from __future__ import annotations
+
+from .guided_repair import investigate_failed_ranges
+
+
+def checked_ranges(scan: dict, device: dict, *, maximum: int = 32) -> list[dict]:
+    if not isinstance(scan, dict) or not isinstance(device, dict):
+        raise ValueError('Missing previous scan and current device identity')
+    scanned = scan.get('device')
+    if not isinstance(scanned, dict) or scanned.get('identity_hint') != device.get('identity_hint'):
+        raise ValueError('Prior scan belongs to another device. No reads were started')
+    size = int(device.get('size_bytes') or 0)
+    sector = int(device.get('sector_size') or 0)
+    if (size <= 0 or sector <= 0 or size % sector or
+            scan.get('device_size_bytes') != size or scan.get('logical_sector_bytes') != sector):
+        raise ValueError('Geometry changed since scan; cannot reuse suspect offsets')
+    candidates = scan.get('read_error_ranges')
+    if not isinstance(candidates, list) or len(candidates) > 4096 or not candidates:
+        raise ValueError('No bounded failed ranges in the prior scan; do not invent repair targets')
+    accepted: list[dict] = []
+    for raw in candidates[:maximum]:
+        if not isinstance(raw, dict):
+            raise ValueError('Invalid prior scan range')
+        off, length = raw.get('offset'), raw.get('length')
+        if (type(off) is not int or type(length) is not int or off < 0 or length < sector or
+                off % sector or length % sector or off + length > size):
+            raise ValueError('Malformed or unaligned failed range')
+        accepted.append({'offset': off, 'length': length})
+    return accepted
+
+
+def recheck_errors(scan: dict, device: dict, reader, *, max_reads: int = 96,
+                   max_elapsed_seconds: float = 75.0) -> dict:
+    ranges = checked_ranges(scan, device)
+    info = investigate_failed_ranges(reader, ranges,
+        sector=int(device['sector_size']), max_regions=len(ranges),
+        max_reads=max_reads, max_elapsed_seconds=max_elapsed_seconds,
+        max_probe_bytes=65536)
+    unresolved = info['unresolved_regions']
+    # Never use a success status for remediation: only a read-only follow-up.
+    return {'status': 'read_only_suspect_recheck_completed',
+            'device': {'identity_hint': device['identity_hint'], 'model': device.get('model')},
+            'scan_regions_considered': len(ranges),
+            'original_read_failures': scan.get('read_error_chunks'),
+            'repeatably_readable_ranges': info['consistent_regions'],
+            'unresolved_ranges': unresolved,
+            'read_calls': info['read_calls'],
+            'remaining_unchecked': bool(info.get('budget_exhausted')) or
+                                   bool(scan.get('read_error_ranges_truncated')),
+            'patient_writes': 0,
+            'verified_files': 0,
+            'message': 'Rechecked prior failed addresses without repeating the full scan. '
+                       'No source sectors were repaired or written. To save data use Rescue to image; '
+                       'repeatability does not prove original bytes.'}
diff --git a/desktop/driverepair_desktop/vendor/windows/README.md b/desktop/driverepair_desktop/vendor/windows/README.md
new file mode 100644
--- /dev/null
+++ b/desktop/driverepair_desktop/vendor/windows/README.md
@@ -0,0 +1,16 @@
+# Offline Windows SMART component
+
+This directory is a deployment slot for `smartctl.exe` from the **upstream
+smartmontools** project. DriveRepair includes read-only ATA/SAT/NVMe SMART
+integration, but cannot manufacture missing controller passthrough capabilities.
+
+To ship SMART as a standard part of a Windows release, obtain the authentic
+smartmontools Windows executable from the official upstream release, verify the
+publisher-signed archive, stage it using `scripts/vendor_smartctl.py`, and
+include the companion `dist/tools/smartmontools` directory alongside the
+DriveRepair `.pyz` launcher. The launcher checks SHA-256 on every discovery.
+
+**A local SHA-256 file is an integrity check, not an upstream signature.**
+Verify the original distribution independently and comply with smartmontools'
+GPL source/license distribution obligations. No arbitrary code is fetched or
+executed during DriveRepair's recovery or repair workflow.
diff --git a/desktop/driverepair_desktop/windows_iso_build.py b/desktop/driverepair_desktop/windows_iso_build.py
new file mode 100644
--- /dev/null
+++ b/desktop/driverepair_desktop/windows_iso_build.py
@@ -0,0 +1,103 @@
+"""Prepare an explicit, isolated Debian-WSL live ISO build from Windows.
+
+Only builds ordinary files. Never chooses, formats, or writes a USB disk.
+Requires an *existing* Debian WSL distribution; no implicit installation or
+privilege escalation is performed by the preparation function. The caller
+must obtain user consent before starting the root WSL build process.
+"""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import subprocess
+import sys
+import zipfile
+
+
+def wsl_path(path: str | Path, *, runner=subprocess.run) -> str:
+    """Convert an absolute Windows filesystem path without shell interpolation."""
+    value = str(Path(path).resolve())
+    done = runner(['wsl.exe', '-d', 'Debian', '--exec', 'wslpath', '-u', value],
+                  capture_output=True, text=True, timeout=15, check=False)
+    if done.returncode or not done.stdout.strip().startswith('/'):
+        raise RuntimeError('Debian WSL could not resolve the Windows build path: '
+                           + (done.stderr or '').strip()[:220])
+    return done.stdout.strip()
+
+
+def require_debian_wsl(*, runner=subprocess.run) -> None:
+    if sys.platform != 'win32':
+        raise RuntimeError('Debian WSL ISO building is only for Windows hosts')
+    try:
+        done = runner(['wsl.exe', '--list', '--quiet'], capture_output=True,
+                      timeout=18, check=False)
+    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
+        raise RuntimeError('WSL is unavailable. Install WSL and Debian first; no USB was written.') from exc
+    # Windows WSL may output UTF-16LE (even without an explicit encoding flag).
+    content = done.stdout if isinstance(done.stdout, bytes) else str(done.stdout).encode()
+    decoded = content.decode('utf-16-le', 'ignore') if b'\x00' in content else content.decode('utf-8', 'ignore')
+    if done.returncode or 'Debian' not in [line.strip().strip('\x00') for line in decoded.splitlines()]:
+        raise RuntimeError('Debian WSL distribution not installed. Run "wsl --install -d Debian" '
+                           'from an administrator terminal; reboot if prompted. No installation was started.')
+
+
+# This static shell script copies the checkout to native WSL storage before
+# running live-build. Building directly on /mnt/c may break Unix permissions,
+# device nodes, symlinks and filesystem assumptions of debootstrap.
+_WSL_BUILD_SCRIPT = r'''set -euo pipefail
+SOURCE_DIR="$1"
+OUTPUT_DIR="$2"
+if [[ -z "$SOURCE_DIR" || -z "$OUTPUT_DIR" || "$OUTPUT_DIR" == / ]]; then
+  echo 'Unsafe WSL build arguments' >&2; exit 2
+fi
+if [[ "$(id -u)" != 0 ]]; then echo 'Debian WSL root required' >&2; exit 2; fi
+if ! command -v lb >/dev/null || ! command -v debootstrap >/dev/null || ! command -v xorriso >/dev/null; then
+  echo 'Installing Debian live-build prerequisites in isolated WSL distro (approved by operator).' >&2
+  apt-get update
+  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends live-build debootstrap xorriso
+fi
+WORK="$(mktemp -d /tmp/driverepair-wsl-build.XXXXXXXX)"
+trap 'echo "Build workspace retained for review: $WORK"' EXIT
+cp -a -- "$SOURCE_DIR/driverepair" "$WORK/driverepair"
+mkdir -- "$WORK/output"
+bash "$WORK/driverepair/scripts/build_live_iso.sh" "$WORK/output"
+shopt -s nullglob
+artifacts=("$WORK/output"/*.iso "$WORK/output"/*.sha256)
+if (( ${#artifacts[@]} < 2 )); then echo 'ISO or checksum missing' >&2; exit 4; fi
+for entry in "${artifacts[@]}"; do
+  name="${entry##*/}"
+  if [[ -e "$OUTPUT_DIR/$name" ]]; then echo 'Refusing to overwrite existing ISO: '$name >&2; exit 5; fi
+done
+cp -- "${artifacts[@]}" "$OUTPUT_DIR/"
+echo 'STRUCTURAL ISO VALIDATION PASSED. BIOS/UEFI actual boot remains unverified.'
+'''
+
+
+def prepare_wsl_build(repo: str | Path | None, staging: str | Path, destination: str | Path,
+                      *, runner=subprocess.run) -> tuple[list[str], dict]:
+    """Create kit and WSL invocation. Destination must already exist and be empty."""
+    from .boot_media import export_build_kit
+    stage = Path(staging).resolve()
+    dest = Path(destination).resolve()
+    if not dest.is_dir() or any(dest.iterdir()):
+        raise ValueError('Select an empty existing destination folder (no files may be overwritten)')
+    if stage == dest or dest.is_relative_to(stage):
+        raise ValueError('Build staging directory and output destination must be separate')
+    stage.mkdir(parents=True, exist_ok=True)
+    kit = stage / 'driverepair-build.zip'
+    if kit.exists():
+        raise ValueError('Choose a fresh build staging directory')
+    export_build_kit(repo, kit)
+    with zipfile.ZipFile(kit) as z:
+        for item in z.infolist():
+            # Archive is authored by DriveRepair; still enforce containment.
+            parts = Path(item.filename).parts
+            if not parts or parts[0] != 'driverepair' or '..' in parts or item.filename.startswith('/'):
+                raise ValueError('Unsafe build-kit member')
+        z.extractall(stage)
+    stage_wsl = wsl_path(stage, runner=runner)
+    out_wsl = wsl_path(dest, runner=runner)
+    args = ['wsl.exe', '-d', 'Debian', '-u', 'root', '--exec',
+            'bash', '-c', _WSL_BUILD_SCRIPT, 'driverepair-wsl-build', stage_wsl, out_wsl]
+    return args, {'staging': str(stage), 'destination': str(dest), 'debian_root': True,
+                  'downloads': False, 'writes_physical_media': False}
