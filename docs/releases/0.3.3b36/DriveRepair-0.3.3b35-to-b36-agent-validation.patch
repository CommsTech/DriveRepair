+name: DriveRepair explicit qualification (NOT automatic release)
+on:
+  workflow_dispatch:
+
+# Deliberately optional until this Forge has a configured Windows runner and a
+# privileged Ubuntu VM runner. Absence of either is NOT_PROVEN, never PASS.
+# Neither job uses a physical disk; HP and dock write tests remain manual.
+jobs:
+  windows-native-qt:
+    name: Native Windows Qt synthetic UI (NO PHYSICAL DISK)
+    runs-on: windows-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+      - uses: actions/setup-python@0b93645e9fea7318ecaed2b359559ac225c90a2b # v5.3.0
+        with:
+          python-version: '3.11'
+      - name: Install Qt and pytest
+        run: python -m pip install pytest==8.4.2 "PySide6>=6.6,<7"
+      - name: Run real native Qt widgets against synthetic devices
+        env:
+          DRIVEREPAIR_QT_TEST_NO_DEVICES: '1'
+          DRIVEREPAIR_QT_SMOKE: '1'
+          QT_QPA_PLATFORM: 'offscreen'
+        run: python -m pytest -v desktop/tests/test_native_qt_workflows.py desktop/tests/test_qt_ux_pass.py
+
+  bios-uefi-iso:
+    name: Actual ISO build + BIOS and UEFI VM boots (NO PHYSICAL DISK)
+    runs-on: ubuntu-latest
+    timeout-minutes: 100
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+      - name: Install isolated ISO and VM prerequisites
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y live-build debootstrap xorriso qemu-system-x86 ovmf
+      - name: Build real hybrid ISO as root (no disk flash)
+        run: sudo bash scripts/build_live_iso.sh "$RUNNER_TEMP/driverepair-iso"
+      - name: Boot independently under SeaBIOS and OVMF
+        run: |
+          ISO="$RUNNER_TEMP/driverepair-iso/DriveRepair-Live-amd64-UNVERIFIED.iso"
+          python3 scripts/smoke_live_iso.py --iso "$ISO" --output "$RUNNER_TEMP/driverepair-vm-evidence" --timeout-seconds 360
