diff --git a/scripts/qa_smart_probe.py b/scripts/qa_smart_probe.py
new file mode 100644
index 0000000..0df518a
--- /dev/null
+++ b/scripts/qa_smart_probe.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Read-only, sanitized Windows USB bridge diagnostic for hardware QA.
+
+This is NOT a physical repair eligibility certificate or write authorization.
+Only standard smartctl identity/health queries are sent; full serial numbers,
+raw stdout/stderr, device WWNs and path-identifying JSON are not saved.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+def windows_alias(device: str) -> str:
+    match = re.fullmatch(r'windows:PhysicalDrive([0-9]{1,3})', device, re.IGNORECASE)
+    if not match:
+        raise ValueError('Expected windows:PhysicalDriveN (N in 0..999); not a path or volume')
+    return '/dev/pd' + str(int(match.group(1)))
+
+
+def _attempt(executable: str, alias: str, mode: str | None, run) -> dict:
+    args = [executable, '-j', '-i', '-H']
+    if mode:
+        args += ['-d', mode]
+    args.append(alias)
+    try:
+        completed = run(args, timeout=20, capture_output=True, check=False)
+    except subprocess.TimeoutExpired:
+        return {'mode': mode or 'auto', 'status': 'TIMEOUT', 'exit_code': None}
+    except OSError:
+        return {'mode': mode or 'auto', 'status': 'TOOL_FAILED', 'exit_code': None}
+    try:
+        raw = completed.stdout
+        if isinstance(raw, bytes):
+            raw = raw[:1024*1024].decode('utf-8', errors='replace')
+        payload = json.loads(str(raw)[:1024*1024])
+    except (TypeError, ValueError):
+        payload = {}
+    if not isinstance(payload, dict):
+        payload = {}
+    smart = payload.get('smartctl') if isinstance(payload.get('smartctl'), dict) else {}
+    health = payload.get('smart_status') if isinstance(payload.get('smart_status'), dict) else {}
+    device = payload.get('device') if isinstance(payload.get('device'), dict) else {}
+    exit_bits = smart.get('exit_status')
+    if type(exit_bits) is not int:
+        exit_bits = completed.returncode
+    output = {'mode': mode or 'auto', 'status': 'UNVERIFIED',
+              'exit_code': int(completed.returncode),
+              'exit_bits': int(exit_bits) if type(exit_bits) is int else None,
+              'protocol': str(device.get('protocol') or 'unknown')[:32],
+              'smart_passed': health.get('passed') if type(health.get('passed')) is bool else None,
+              'rotation_rate_rpm': payload.get('rotation_rate') if type(payload.get('rotation_rate')) is int else None}
+    identified = bool(output['protocol'] != 'unknown' and
+                      (output['smart_passed'] is not None or output['rotation_rate_rpm'] is not None))
+    if exit_bits is not None and (exit_bits & 3) == 0 and identified:
+        output['status'] = 'PROBED_READ_ONLY'
+    return output
+
+
+def probe(device: str, *, executable: str = 'smartctl', run=subprocess.run) -> dict:
+    alias = windows_alias(device)
+    first = _attempt(executable, alias, None, run)
+    attempts = [first]
+    if first['status'] not in {'PROBED_READ_ONLY', 'TIMEOUT'}:
+        attempts.append(_attempt(executable, alias, 'sat', run))
+    return {'status': 'PROBED_READ_ONLY' if any(x['status']=='PROBED_READ_ONLY' for x in attempts) else 'UNVERIFIED',
+            'device_alias': alias, 'read_only': True, 'authorizes_writes': False,
+            'attempts': attempts, 'notice': ('Unknown/USB-bridged SMART is not a physical write permit. '
+                'Use a stable verified rotational HDD, separate journal, and exclusive lock for manual testing.')}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--device', required=True, help='windows:PhysicalDriveN (not a Windows volume)')
+    parser.add_argument('--smartctl', default='smartctl')
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    try:
+        result = probe(args.device, executable=args.smartctl)
+    except ValueError as exc:
+        parser.error(str(exc))
+    if args.output.exists():
+        parser.error('Output exists; choose a new file to avoid overwriting QA evidence')
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open('x', encoding='utf-8') as handle:
+        json.dump(result, handle, indent=2)
+        handle.write('\n')
+    print(f"SMART QA {result['device_alias']}: {result['status']} (no writes, no serials saved)")
+    return 0 if result['status'] == 'PROBED_READ_ONLY' else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/scripts/smoke_live_iso.py b/scripts/smoke_live_iso.py
new file mode 100644
index 0000000..fd69438
--- /dev/null
+++ b/scripts/smoke_live_iso.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Boot a DriveRepair live ISO in isolated BIOS/UEFI QEMU VMs, no hard disks.
+
+PASS means the live guest reached XFCE and started the DriveRepair GUI process,
+then emitted a QEMU-only marker over its serial port. It does NOT qualify USB
+hardware, Secure Boot, or physical laptop compatibility. No patient storage is
+attached to these machines. Never accept a device/block special file as an ISO.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import tempfile
+import time
+
+READY = 'DRIVEREPAIR_LIVE_READY:GUI_STARTED'
+
+
+def make_qemu_command(firmware: str, iso: str, serial: str, *,
+                      ovmf_code: str | None = None, ovmf_vars: str | None = None) -> list[str]:
+    if firmware not in {'bios', 'uefi'}:
+        raise ValueError('firmware must be bios or uefi')
+    args = ['qemu-system-x86_64', '-nodefaults', '-machine', 'pc',
+            '-m', '2048', '-smp', '2', '-vga', 'std', '-display', 'none',
+            '-nic', 'none', '-no-reboot', '-boot', 'order=d',
+            '-serial', 'file:' + str(serial), '-cdrom', str(iso)]
+    if firmware == 'uefi':
+        if not ovmf_code or not ovmf_vars:
+            raise ValueError('UEFI requires OVMF code and separate temporary variables')
+        args.extend(['-drive', 'if=pflash,format=raw,unit=0,readonly=on,file=' + str(ovmf_code),
+                     '-drive', 'if=pflash,format=raw,unit=1,file=' + str(ovmf_vars)])
+    return args
+
+
+def _ovmf_files() -> tuple[Path, Path] | None:
+    candidates = [('OVMF_CODE_4M.fd', 'OVMF_VARS_4M.fd'),
+                  ('OVMF_CODE.fd', 'OVMF_VARS.fd')]
+    for folder in ('/usr/share/OVMF', '/usr/share/ovmf/x64'):
+        for code, variables in candidates:
+            paths = Path(folder) / code, Path(folder) / variables
+            if all(path.is_file() for path in paths):
+                return paths
+    return None
+
+
+def _hash(path: Path) -> str:
+    with path.open('rb') as handle:
+        checksum = hashlib.sha256()
+        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
+            checksum.update(chunk)
+        return checksum.hexdigest()
+
+
+def boot_once(firmware: str, iso: Path, output: Path, timeout: int) -> dict:
+    serial = output / f'{firmware}.serial.log'
+    if not shutil.which('qemu-system-x86_64'):
+        return {'status': 'NOT_PROVEN', 'reason': 'qemu-system-x86_64 unavailable'}
+    with tempfile.TemporaryDirectory(prefix='driverepair-ovmf-') as temporary:
+        kwargs = {}
+        if firmware == 'uefi':
+            files = _ovmf_files()
+            if files is None:
+                return {'status': 'NOT_PROVEN', 'reason': 'OVMF firmware files unavailable'}
+            code, original_vars = files
+            vars_copy = Path(temporary) / 'OVMF_VARS.fd'
+            shutil.copyfile(original_vars, vars_copy)
+            kwargs = {'ovmf_code': str(code), 'ovmf_vars': str(vars_copy)}
+        cmd = make_qemu_command(firmware, str(iso), str(serial), **kwargs)
+        start = time.monotonic()
+        error_file = output / f'{firmware}.qemu.err'
+        stderr_handle = error_file.open('wb')
+        try:
+            proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL,
+                                    stdout=subprocess.DEVNULL, stderr=stderr_handle)
+        except OSError as exc:
+            stderr_handle.close()
+            return {'status': 'NOT_PROVEN', 'reason': f'QEMU start failed: {exc}'}
+        result = {'status': 'FAIL', 'reason': 'no guest GUI-ready marker received'}
+        try:
+            while time.monotonic() - start < timeout:
+                if serial.is_file():
+                    # Read a bounded tail only; never ingest unbounded guest logs.
+                    with serial.open('rb') as handle:
+                        handle.seek(max(0, serial.stat().st_size - 65536))
+                        snapshot = handle.read().decode('utf-8', errors='replace')
+                    if READY in snapshot:
+                        result = {'status': 'PASS', 'reason': 'guest GUI process confirmed over serial'}
+                        break
+                    if 'DRIVEREPAIR_LIVE_FAIL:' in snapshot:
+                        result = {'status': 'FAIL', 'reason': 'guest reported boot or GUI startup failure'}
+                        break
+                if proc.poll() is not None:
+                    result = {'status': 'FAIL', 'reason': f'QEMU exited early (code {proc.returncode})'}
+                    break
+                time.sleep(1)
+            else:
+                result = {'status': 'FAIL', 'reason': f'boot timeout ({timeout}s)'}
+        finally:
+            if proc.poll() is None:
+                proc.terminate()
+                try:
+                    proc.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    proc.kill()
+                    proc.wait(timeout=5)
+            stderr_handle.close()
+            if result['status'] != 'PASS' and error_file.is_file():
+                with error_file.open('rb') as handle:
+                    handle.seek(max(0, error_file.stat().st_size - 4096))
+                    error_output = handle.read().decode('utf-8', errors='replace').strip()
+                if error_output:
+                    result['qemu_stderr_excerpt'] = error_output[-1500:]
+        result['serial_log'] = str(serial)
+        result['elapsed_seconds'] = round(time.monotonic() - start, 1)
+        return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--iso', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--timeout-seconds', type=int, default=240)
+    parser.add_argument('--firmware', choices=['bios', 'uefi', 'both'], default='both')
+    args = parser.parse_args()
+    iso = args.iso.resolve()
+    if not iso.is_file() or not stat.S_ISREG(iso.stat().st_mode) or not iso.name.lower().endswith('.iso'):
+        parser.error('--iso must be an existing ordinary ISO file (not a raw/block device)')
+    if args.timeout_seconds < 30:
+        parser.error('boot time limit must be at least 30 seconds')
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    modes = ('bios', 'uefi') if args.firmware == 'both' else (args.firmware,)
+    result = {'iso': iso.name, 'iso_sha256': _hash(iso),
+              'tests': {mode: boot_once(mode, iso, output, args.timeout_seconds) for mode in modes}}
+    (output / 'vm_boot_evidence.json').write_text(json.dumps(result, indent=2) + '\n', encoding='utf-8')
+    print(json.dumps(result, indent=2))
+    return 0 if all(entry['status'] == 'PASS' for entry in result['tests'].values()) else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
