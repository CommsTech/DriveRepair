#!/usr/bin/env bash
# Pre-push git hook to prevent pushing bad code
# Install with: ln -s ../../.githooks/pre-push .git/hooks/pre-push

set -e

echo "Running pre-push checks..."

# Check if cargo is available
if ! command -v cargo &> /dev/null; then
    echo "Error: cargo not found. Please install Rust."
    exit 1
fi

# Format check
echo "Checking code formatting..."
cargo fmt -- --check || {
    echo "Error: Code is not formatted. Run 'cargo fmt' to fix."
    exit 1
}

# Clippy check
echo "Running clippy..."
cargo clippy --all-targets --all-features -- -D warnings || {
    echo "Error: Clippy found issues. Please fix them."
    exit 1
}

# Build check
echo "Checking build..."
cargo check --all-targets --all-features || {
    echo "Error: Build check failed."
    exit 1
}

# Run tests (skip platform-specific tests that require privileged instructions)
echo "Running tests..."
cargo test --features "std,alloc" --lib -- --skip test_ata_port_io_read_register --skip test_detect_nvme_controllers --skip test_detect_ahci_controllers || {
    echo "Error: Tests failed."
    exit 1
}

echo "Checking DriveRepair release metadata (Python 3.10+)..."
# Prefer an interpreter that can actually execute the hygiene script. Git Bash
# often exposes a stub or older python3 first on Windows; verify before using.
run_release_hygiene() {
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        python3 scripts/check_release_hygiene.py
        return $?
    fi
    if command -v python >/dev/null 2>&1 && python -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        python scripts/check_release_hygiene.py
        return $?
    fi
    if command -v py >/dev/null 2>&1 && py -3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        py -3 scripts/check_release_hygiene.py
        return $?
    fi
    echo "Error: Python 3.10+ is required for release metadata checks (matches desktop requires-python)."
    return 1
}
run_release_hygiene || exit 1

echo "All pre-push checks passed!"
exit 0